{
  "manifest_version": 3,
  "name": "Audio Cursor",
  "version": "2.2.1",
  "description": "Read any page like a text editor — click to place a cursor, select with the keyboard, and listen to it.",
  "permissions": [
    "storage",
    "tts",
    "contextMenus",
    "clipboardRead",
    "offscreen",
    "declarativeNetRequest",
    "downloads"
  ],
  "host_permissions": [
    "*://speech.platform.bing.com/*",
    "wss://speech.platform.bing.com/*",
    "https://translate.google.com/*"
  ],
  "commands": {
    "play-selection": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Read selected text with Audio Cursor"
    },
    "download-selection": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Download selected text as MP3 audio"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "extension-build/icons/icon16.png",
    "32": "extension-build/icons/icon32.png",
    "48": "extension-build/icons/icon48.png",
    "128": "extension-build/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "extension-build/icons/icon16.png",
      "32": "extension-build/icons/icon32.png",
      "48": "extension-build/icons/icon48.png",
      "128": "extension-build/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "extension-build/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/shared/voices.json", "extension-build/voices.json", "extension-build/offscreen.html", "extension-build/offscreen.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://docs.google.com/*"],
      "js": ["extension-build/docs-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["extension-build/content.js"],
      "css": ["extension-build/content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
