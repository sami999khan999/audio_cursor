{
  "manifest_version": 3,
  "name": "Audio Cursor",
  "version": "2.0.0",
  "description": "Select any text and listen to it — floating player, live word sync, keyboard shortcut.",
  "permissions": [
    "storage",
    "tts"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"]
    }
  ]
}
